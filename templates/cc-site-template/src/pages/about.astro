---
import Layout from '../layouts/Layout.astro';
import { client } from '../config/client';
import { brand } from '../config/brand';
---

<Layout
  title={`About Us | ${client.name}`}
  description={`Learn about ${client.name} — ${client.tagline}`}
>

  <!-- Page hero -->
  <section
    class="pt-32 pb-20 text-white text-center"
    style={`background-color: ${brand.heroDark}`}
  >
    <div class="max-w-3xl mx-auto px-4">
      <p class="text-sm font-semibold uppercase tracking-widest mb-4" style={`color: ${brand.accent}`}>
        Who We Are
      </p>
      <h1 class="font-heading text-6xl sm:text-7xl text-white mb-4">About Us</h1>
      <p class="text-gray-400 text-lg">{client.tagline}</p>
    </div>
  </section>

  <!-- Story section -->
  <section class="section-pad bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="aspect-[4/3] rounded-lg overflow-hidden bg-gray-100">
          <img src="/images/about.jpg" alt={`${client.name} team`} class="w-full h-full object-cover" loading="lazy" />
        </div>
        <div>
          <h2 class="font-heading text-5xl text-gray-900 mb-6">Our Story</h2>
          <p class="text-gray-500 leading-relaxed mb-5">{client.description}</p>
          <p class="text-gray-500 leading-relaxed mb-5">
            With years of hands-on experience across residential, commercial, and industrial sites,
            we've built a reputation for showing up on time, doing the job right, and standing behind our work.
          </p>
          <p class="text-gray-500 leading-relaxed">
            Every technician on our team is registered, insured, and committed to delivering a certificate
            of compliance on every relevant job — so you know it's done properly.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="section-pad" style={`background-color: ${brand.surfaceAlt}`}>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-heading text-5xl text-gray-900 mb-14">Why Choose Us</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">
        {[
          { heading: 'Always On Time', body: "We respect your schedule. If we say we'll be there at 9am, we'll be there at 9am." },
          { heading: 'Quality Guaranteed', body: 'All work is backed by a 12-month workmanship guarantee. No shortcuts, no comebacks.' },
          { heading: 'Honest Pricing', body: 'You get a clear quote upfront. No hidden fees, no surprise invoices.' },
        ].map(v => (
          <div class="bg-white rounded-lg p-8 border border-gray-100">
            <div
              class="w-12 h-1 rounded-full mb-5 mx-auto"
              style={`background-color: ${brand.accent}`}
            ></div>
            <h3 class="font-heading text-2xl text-gray-900 mb-3">{v.heading}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 text-center text-white" style={`background-color: ${brand.heroDark}`}>
    <div class="max-w-xl mx-auto px-4">
      <h2 class="font-heading text-5xl mb-4">Ready to Get Started?</h2>
      <p class="text-gray-400 mb-8">Call us now or send a message — we respond fast.</p>
      <a
        href="/contact"
        class="inline-flex items-center gap-2 px-8 py-4 font-bold text-white rounded-sm hover:brightness-110 transition-all"
        style={`background-color: ${brand.accent}`}
      >
        Contact Us
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>
  </section>

</Layout>
