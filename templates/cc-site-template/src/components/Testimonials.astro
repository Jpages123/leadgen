---
import { client } from '../config/client';
import { brand } from '../config/brand';
---

{(brand.showTestimonials !== false && client.testimonials && client.testimonials.length > 0) && (
<section class="section-pad" style={`background-color: ${brand.heroDark}`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center mb-14">
      <p class="text-sm font-semibold uppercase tracking-widest mb-3" style={`color: ${brand.accent}`}>
        What Clients Say
      </p>
      <h2 class="font-heading text-5xl sm:text-6xl text-white">
        Reviews
      </h2>
    </div>

    <!-- Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {client.testimonials.map(testimonial => (
        <div class="bg-white/5 border border-white/10 rounded-lg p-8 flex flex-col">

          <!-- Stars -->
          <div class="flex gap-1 mb-5">
            {Array.from({ length: testimonial.rating }).map(() => (
              <svg class="w-5 h-5" style={`color: ${brand.accent}`} fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>

          <!-- Quote -->
          <blockquote class="text-gray-300 text-sm leading-relaxed flex-1 mb-6">
            "{testimonial.text}"
          </blockquote>

          <!-- Attribution -->
          <div class="flex items-center gap-3 pt-5 border-t border-white/10">
            <div
              class="w-9 h-9 rounded-full flex items-center justify-center text-white font-bold text-sm shrink-0"
              style={`background-color: ${brand.accent}`}
            >
              {testimonial.name[0]}
            </div>
            <div>
              <div class="text-white font-semibold text-sm">{testimonial.name}</div>
              <div class="text-gray-500 text-xs">{testimonial.source} Review</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
)}
