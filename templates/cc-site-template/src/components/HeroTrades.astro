---
import { client } from '../config/client';
import { brand } from '../config/brand';

// HeroTrades - Professional calling-card style for trades verticals.
// Used when brand.template === 'trades' (chosen by Pi).
// - Dark overlay, bold Oswald headlines, prominent service grid
// - Trust badges pulled from brand.trustBadges (Pi selects 3-4)
// - "Call now" CTA, secondary "Our Services" button
---

<section
  class="relative min-h-screen flex items-center justify-center overflow-hidden"
  style={`background-color: ${brand.heroDark}`}
>
  <!-- Background image with dark overlay -->
  <div class="absolute inset-0">
    <img
      src={brand.heroImage}
      alt={`${client.name} - ${client.tagline}`}
      class="w-full h-full object-cover"
      style={`opacity: ${(100 - (brand.heroOverlayOpacity || 55)) / 100}`}
      loading="eager"
      fetchpriority="high"
    />
    <!-- Gradient overlay: darker at bottom for text legibility -->
    <div
      class="absolute inset-0"
      style={`background: linear-gradient(to bottom, rgba(0,0,0,${(brand.heroOverlayOpacity || 55) / 100 * 0.3}), rgba(0,0,0,${(brand.heroOverlayOpacity || 55) / 100 * 0.7}))`}
    ></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-20 text-center">

    <!-- Eyebrow badge - data-driven from client.tagline (no more hardcoded "Available 24/7 - Cape Town") -->
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-white/20 bg-white/10 backdrop-blur-sm mb-8">
      <span class="w-2 h-2 rounded-full animate-pulse" style={`background-color: ${brand.accent}`}></span>
      <span class="text-white/90 text-xs sm:text-sm font-medium tracking-widest uppercase">
        {client.tagline}
      </span>
    </div>

    <!-- Main headline -->
    <h1 class="font-heading text-6xl sm:text-7xl md:text-8xl lg:text-9xl text-white leading-none tracking-wide mb-6">
      {client.name}
    </h1>

    <!-- Subline -->
    <p class="text-base sm:text-xl text-white/70 font-light max-w-2xl mx-auto mb-10 leading-relaxed">
      {client.description}
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
      {client.phone && (
        <a
          href={`tel:${client.phone}`}
          class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 text-white font-bold text-base sm:text-lg rounded-sm transition-all duration-200 hover:brightness-110 active:scale-95"
          style={`background-color: ${brand.accent}`}
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
          </svg>
          Call {client.phone}
        </a>
      )}
      <a
        href="/#services"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 text-white font-bold text-base sm:text-lg rounded-sm border-2 border-white/30 hover:border-white/60 hover:bg-white/10 transition-all duration-200"
      >
        Our Services
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </a>
    </div>

    <!-- Trust strip - from brand.trustBadges (was hardcoded) -->
    {brand.trustBadges && brand.trustBadges.length > 0 && (
      <div class="flex flex-wrap items-center justify-center gap-6 text-white/50 text-sm">
        {brand.trustBadges.slice(0, 4).map(badge => (
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4" style={`color: ${brand.accent}`} fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            {badge}
          </div>
        ))}
      </div>
    )}
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <svg class="w-6 h-6 text-white/40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </div>
</section>
