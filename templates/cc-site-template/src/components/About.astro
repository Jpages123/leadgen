---
import { client } from '../config/client';
import { brand } from '../config/brand';
---

<section id="about" class="section-pad bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">

      <!-- Image side -->
      <div class="relative">
        <div class="aspect-[4/3] rounded-lg overflow-hidden bg-gray-100">
          <img
            src="/images/about.jpg"
            alt={`${client.name} team`}
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <!-- Floating accent card -->
        <div
          class="absolute -bottom-6 -right-6 hidden sm:flex flex-col items-center justify-center w-32 h-32 rounded-lg text-white shadow-xl"
          style={`background-color: ${brand.accent}`}
        >
          <span class="font-heading text-4xl leading-none">{client.stats[2]?.value ?? '10+'}</span>
          <span class="text-xs text-white/80 text-center mt-1 leading-tight px-2">Years Experience</span>
        </div>
      </div>

      <!-- Text side -->
      <div>
        <p class="text-sm font-semibold uppercase tracking-widest mb-4" style={`color: ${brand.accent}`}>
          {brand.template === 'creative' ? 'Our Story' : 'Who We Are'}
        </p>
        <h2 class="font-heading text-5xl sm:text-6xl text-gray-900 leading-none mb-6">
          About {client.name}
        </h2>
        <p class="text-gray-500 leading-relaxed mb-6">
          {client.description}
        </p>
        <p class="text-gray-500 leading-relaxed mb-8">
          {/* Second paragraph pulls from brand.trustBadges intro + client.description, OR client.about if populated */}
          {client.about ?? (
            brand.template === 'creative'
              ? `From weddings to portraits to commercial work, ${client.name} brings a creative eye and technical expertise to every shoot.`
              : brand.template === 'trades'
                ? `From emergency call-outs to planned jobs, ${client.name} responds fast with quality workmanship at fair prices.`
                : `${client.name} prides themselves on quality service and customer satisfaction across every job.`
          )}
        </p>

        <!-- Checkmarks - data-driven from brand.trustBadges (Pi-populated, template-specific) -->
        <ul class="space-y-3 mb-10">
          {(brand.trustBadges ?? ['Registered & Insured', 'Quality Guaranteed', 'Customer First']).slice(0, 4).map(item => (
            <li class="flex items-center gap-3 text-gray-700">
              <span
                class="flex-shrink-0 w-5 h-5 rounded-full flex items-center justify-center"
                style={`background-color: ${brand.accent}`}
              >
                <svg class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
              </span>
              <span class="text-sm font-medium">{item}</span>
            </li>
          ))}
        </ul>

        <a
          href="/about"
          class="inline-flex items-center gap-2 font-semibold transition-colors duration-200"
          style={`color: ${brand.accent}`}
        >
          {brand.template === 'creative' ? 'See More Of Our Work' : 'Learn More About Us'}
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>
